{
  "groups": [
    {
      "label": "Expressions",
      "examples": [
        {
          "label": "Arithmetic",
          "text": [
            "// Arithmetic — classic LL(1) form",
            "// Left recursion eliminated",
            "E -> T E'",
            "E' -> + T E' | eps",
            "T -> F T'",
            "T' -> * F T' | eps",
            "F -> id"
          ]
        },
        {
          "label": "Arithmetic + parens",
          "text": [
            "// Arithmetic with parentheses",
            "E -> T E'",
            "E' -> + T E' | eps",
            "T -> F T'",
            "T' -> * F T' | eps",
            "F -> ( E ) | id"
          ]
        }
      ]
    },
    {
      "label": "Structures",
      "examples": [
        {
          "label": "Balanced parentheses",
          "text": [
            "// Balanced parentheses",
            "S -> ( S ) S | eps"
          ]
        },
        {
          "label": "Simple declarations",
          "text": [
            "// Simple declarations (right-factored)",
            "D -> T id D'",
            "D' -> ; | [ num ] ;",
            "T -> int | float | bool"
          ]
        }
      ]
    },
    {
      "label": "Non-LL(1)",
      "examples": [
        {
          "label": "Left-recursive",
          "text": [
            "// Left-recursive — NOT LL(1)",
            "// Shows FIRST/FOLLOW conflict detection",
            "E -> E + T | T",
            "T -> id"
          ]
        },
        {
          "label": "Common prefix (needs left factoring)",
          "text": [
            "// Two alternatives begin with the same symbol: one symbol of lookahead cannot choose",
            "// Fix: factor out the common beginning",
            "S -> a b | a c"
          ]
        },
        {
          "label": "Dangling else (ambiguous)",
          "text": [
            "// The classic ambiguity: both alternatives of S begin with 'if E then S'",
            "S -> if E then S | if E then S else S | other",
            "E -> b"
          ]
        }
      ]
    },
    {
      "label": "Larger",
      "examples": [
        {
          "label": "Mini-Pascal",
          "text": [
            "// Mini-Pascal subset — LL(1)",
            "// Left-recursion eliminated, left-factored",
            "Program -> StmtList",
            "StmtList -> Stmt StmtList'",
            "StmtList' -> ; Stmt StmtList' | eps",
            "Stmt -> id := Expr",
            "Stmt -> if Expr then Stmt else Stmt",
            "Stmt -> while Expr do Stmt",
            "Expr -> Term Expr'",
            "Expr' -> + Term Expr' | - Term Expr' | eps",
            "Term -> Factor Term'",
            "Term' -> * Factor Term' | eps",
            "Factor -> ( Expr ) | id | num"
          ]
        }
      ]
    },
    {
      "label": "Nullable symbols",
      "examples": [
        {
          "label": "FIRST/FOLLOW with ε (nullable chain)",
          "text": [
            "// Every nonterminal after S can vanish: practice FIRST and FOLLOW with nullable symbols",
            "S -> A B C",
            "A -> a | eps",
            "B -> b | eps",
            "C -> c | eps"
          ]
        }
      ]
    },
    {
      "label": "Practical",
      "examples": [
        {
          "label": "JSON-like values",
          "text": [
            "// Tokens are separated by spaces: { \"k\" : 1 , \"l\" : [ 1 , 2 ] }",
            "value -> obj | arr | str | num | true | false | null",
            "obj -> { pairs }",
            "pairs -> pair pairs' | eps",
            "pairs' -> , pair pairs' | eps",
            "pair -> str : value",
            "arr -> [ elems ]",
            "elems -> value elems' | eps",
            "elems' -> , value elems' | eps"
          ]
        }
      ]
    }
  ]
}
