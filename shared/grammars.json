  "parentheses-nested": {
    "label": "Matched parentheses",
    "text": [
      "S -> ( S ) S | eps"
    ]
  },
  "regex-language": {
    "label": "The regex tool's language (left-recursive)",
    "text": [
      "R -> R '|' C | C",
      "C -> C P | P",
      "P -> P '*' | P '+' | P '?' | A",
      "A -> '(' R ')' | a | b | c | d"
    ]
  },
  "sentences": {
    "label": "Sentences (the lecture's running example)",
    "text": [
      "<sentence> → <subject> <predicate>",
      "<subject> → <adjective> <noun>",
      "<predicate> → <verb>",
      "<adjective> → old | big | strong",
      "<noun> → Harry | brother",
      "<verb> → jogs | snores | sleeps"
    ]
  },
  "pascal-declarations": {
    "label": "Pascal excerpt (declarations)",
    "text": [
      "<goal> → <progdecl> .",
      "<progdecl> → <prog_hedr> ; <block>",
      "<prog_hedr> → program <idname> ( <idname_list> ) | program <idname>",
      "<block> → <decls> begin <stat_list> end",
      "<decls> → <labels> <consts> <types> <vars> <procs>",
      "<labels> → label <label_decl> ; | ε",
      "<label_decl> → <label_decl> , <labelid> | <labelid>",
      "<labelid> → <int> | <id>",
      "<consts> → const <const_decls> | ε",
      "<const_decls> → <const_decls> <const_decl_c> | <const_decl_c>",
      "<const_decl_c> → <const_decl> ;",
      "<const_decl> → <idname> = <const>",
      "<types> → type <type_decls> | ε",
      "<type_decls> → <type_decls> <type_decl_c> | <type_decl_c>",
      "<type_decl_c> → <type_decl> ;",
      "<type_decl> → <idname> = <type>",
      "<vars> → var <var_decls> | ε",
      "<var_decls> → <var_decls> <var_decl_c> | <var_decl_c>",
      "<var_decl_c> → <var_decl> ;",
      "<var_decl> → <id_list> : <type>",
      "<procs> → <proc_decls> | ε",
      "<proc_decls> → <proc_decls> <proc> | <proc>",
      "<proc> → procedure <phead_c> forward ; | procedure <phead_c> <block> ; | function <fhead_c> forward ; | function <fhead_c> <block> ;",
      "<fhead_c> → <fhead> ;",
      "<fhead> → <idname> <params> : <type_id>",
      "<phead_c> → <phead> ;",
      "<phead> → <idname> <params> | ε",
      "<params> → ( <param_list> ) | ε",
      "<param> → var <par_decl> | <par_decl> | ε",
      "<par_decl> → <id_list> : <type_id>",
      "<param_list> → <param_list> ; <param> | <param>",
      "<id_list> → <id_list> , <id> | <id>"
    ]
  },
  "sentences-adjective-list": {
    "label": "Sentences with an adjective list (left-recursive)",
    "text": [
      "<sentence> → <subject> <predicate>",
      "<subject> → <adjectives> <noun>",
      "<adjectives> → <adjectives> <adjective> | <adjective>",
      "<predicate> → <verb>",
      "<adjective> → old | big | strong",
      "<noun> → Harry | brother",
      "<verb> → jogs | snores | sleeps"
    ]
  },
  "parentheses-eps": {
    "label": "Balanced parentheses",
    "text": [
      "// Balanced parentheses",
      "S -> ( S ) S | eps"
    ]
  },
  "regex-language-ll": {
    "label": "The regex tool's language (LL(1))",
    "text": [
      "R -> C R'",
      "R' -> '|' C R' | eps",
      "C -> P C'",
      "C' -> P C' | eps",
      "P -> A P'",
      "P' -> '*' P' | '+' P' | '?' P' | eps",
      "A -> '(' R ')' | a | b | c | d"
    ]
  },
  "java-statements-expressions": {
    "label": "Java excerpt: statements and expressions",
    "text": [
      "<block> → '{' <stmts> '}'",
      "<stmts> → <stmts> <stmt> | ε",
      "<stmt> → <block> | <local_decl> ';' | <expr> ';' | if '(' <expr> ')' <stmt> | if '(' <expr> ')' <stmt> else <stmt> | while '(' <expr> ')' <stmt> | return <expr> ';' | return ';'",
      "<local_decl> → <type> <id> | <type> <id> '=' <expr>",
      "<type> → int | boolean",
      "<expr> → <assign>",
      "<assign> → <or> | <id> '=' <assign>",
      "<or> → <or> '||' <and> | <and>",
      "<and> → <and> '&&' <eq> | <eq>",
      "<eq> → <eq> '==' <rel> | <rel>",
      "<rel> → <rel> '<' <add> | <add>",
      "<add> → <add> '+' <mul> | <add> '-' <mul> | <mul>",
      "<mul> → <mul> '*' <unary> | <mul> '/' <unary> | <unary>",
      "<unary> → '!' <unary> | '-' <unary> | <postfix>",
      "<postfix> → <postfix> '.' <id> | <postfix> '(' <args> ')' | <primary>",
      "<primary> → <id> | <num> | true | false | '(' <expr> ')'",
      "<args> → <arg_list> | ε",
      "<arg_list> → <arg_list> ',' <expr> | <expr>"
    ]
  },
  "java-statements-expressions-ll": {
    "label": "Java excerpt (LL(1) form)",
    "text": [
      "<block> → '{' <stmts> '}'",
      "<stmts> → <stmt> <stmts> | ε",
      "<stmt> → <block> | <local_decl> ';' | <expr> ';' | if '(' <expr> ')' <stmt> <else_part> | while '(' <expr> ')' <stmt> | return <ret> ';'",
      "<else_part> → else <stmt> | ε",
      "<ret> → <expr> | ε",
      "<local_decl> → <type> <id> <init>",
      "<init> → '=' <expr> | ε",
      "<type> → int | boolean",
      "<expr> → <assign>",
      "<assign> → <or> <assign_rest>",
      "<assign_rest> → '=' <assign> | ε",
      "<or> → <and> <or_rest>",
      "<or_rest> → '||' <and> <or_rest> | ε",
      "<and> → <eq> <and_rest>",
      "<and_rest> → '&&' <eq> <and_rest> | ε",
      "<eq> → <rel> <eq_rest>",
      "<eq_rest> → '==' <rel> <eq_rest> | ε",
      "<rel> → <add> <rel_rest>",
      "<rel_rest> → '<' <add> <rel_rest> | ε",
      "<add> → <mul> <add_rest>",
      "<add_rest> → '+' <mul> <add_rest> | '-' <mul> <add_rest> | ε",
      "<mul> → <unary> <mul_rest>",
      "<mul_rest> → '*' <unary> <mul_rest> | '/' <unary> <mul_rest> | ε",
      "<unary> → '!' <unary> | '-' <unary> | <postfix>",
      "<postfix> → <primary> <postfix_rest>",
      "<postfix_rest> → '.' <id> <postfix_rest> | '(' <args> ')' <postfix_rest> | ε",
      "<primary> → <id> | <num> | true | false | '(' <expr> ')'",
      "<args> → <expr> <arg_rest> | ε",
      "<arg_rest> → ',' <expr> <arg_rest> | ε"
    ]
  },
  "python-statements-expressions": {
    "label": "Python excerpt: statements and expressions",
    "text": [
      "<file> → <stmts>",
      "<stmts> → <stmts> <stmt> | <stmt>",
      "<stmt> → <simple_stmt> | <compound_stmt>",
      "<simple_stmt> → <small_stmt> NEWLINE",
      "<small_stmt> → pass | return | return <expr> | <expr> | <id> '=' <expr>",
      "<compound_stmt> → <if_stmt> | <while_stmt> | <funcdef>",
      "<if_stmt> → if <expr> ':' <suite> <elifs> <orelse>",
      "<elifs> → <elifs> elif <expr> ':' <suite> | ε",
      "<orelse> → else ':' <suite> | ε",
      "<while_stmt> → while <expr> ':' <suite>",
      "<funcdef> → def <id> '(' <params> ')' ':' <suite>",
      "<suite> → <simple_stmt> | NEWLINE INDENT <stmts> DEDENT",
      "<params> → <id_list> | ε",
      "<id_list> → <id_list> ',' <id> | <id>",
      "<expr> → <or_test>",
      "<or_test> → <or_test> or <and_test> | <and_test>",
      "<and_test> → <and_test> and <not_test> | <not_test>",
      "<not_test> → not <not_test> | <comparison>",
      "<comparison> → <comparison> <comp_op> <arith> | <arith>",
      "<comp_op> → '<' | '>' | '==' | in",
      "<arith> → <arith> '+' <term> | <arith> '-' <term> | <term>",
      "<term> → <term> '*' <factor> | <term> '/' <factor> | <factor>",
      "<factor> → '-' <factor> | <power>",
      "<power> → <primary> '**' <factor> | <primary>",
      "<primary> → <atom> | <primary> '(' <args> ')' | <primary> '.' <id> | <primary> '[' <expr> ']'",
      "<atom> → <id> | <num> | <str> | True | False | None | '(' <expr> ')'",
      "<args> → <arg_list> | ε",
      "<arg_list> → <arg_list> ',' <expr> | <expr>"
    ]
  },
  "python-statements-expressions-ll": {
    "label": "Python excerpt (LL(1) form)",
    "text": [
      "<file> → <stmts>",
      "<stmts> → <stmt> <stmts_rest>",
      "<stmts_rest> → <stmt> <stmts_rest> | ε",
      "<stmt> → <simple_stmt> | <compound_stmt>",
      "<simple_stmt> → <small_stmt> NEWLINE",
      "<small_stmt> → pass | return <ret> | <expr> <assign_rest>",
      "<ret> → <expr> | ε",
      "<assign_rest> → '=' <expr> | ε",
      "<compound_stmt> → <if_stmt> | <while_stmt> | <funcdef>",
      "<if_stmt> → if <expr> ':' <suite> <elifs> <orelse>",
      "<elifs> → elif <expr> ':' <suite> <elifs> | ε",
      "<orelse> → else ':' <suite> | ε",
      "<while_stmt> → while <expr> ':' <suite>",
      "<funcdef> → def <id> '(' <params> ')' ':' <suite>",
      "<suite> → <simple_stmt> | NEWLINE INDENT <stmts> DEDENT",
      "<params> → <id> <id_rest> | ε",
      "<id_rest> → ',' <id> <id_rest> | ε",
      "<expr> → <or_test>",
      "<or_test> → <and_test> <or_rest>",
      "<or_rest> → or <and_test> <or_rest> | ε",
      "<and_test> → <not_test> <and_rest>",
      "<and_rest> → and <not_test> <and_rest> | ε",
      "<not_test> → not <not_test> | <comparison>",
      "<comparison> → <arith> <cmp_rest>",
      "<cmp_rest> → <comp_op> <arith> <cmp_rest> | ε",
      "<comp_op> → '<' | '>' | '==' | in",
      "<arith> → <term> <arith_rest>",
      "<arith_rest> → '+' <term> <arith_rest> | '-' <term> <arith_rest> | ε",
      "<term> → <factor> <term_rest>",
      "<term_rest> → '*' <factor> <term_rest> | '/' <factor> <term_rest> | ε",
      "<factor> → '-' <factor> | <power>",
      "<power> → <primary> <power_rest>",
      "<power_rest> → '**' <factor> | ε",
      "<primary> → <atom> <trailers>",
      "<trailers> → '(' <args> ')' <trailers> | '.' <id> <trailers> | '[' <expr> ']' <trailers> | ε",
      "<atom> → <id> | <num> | <str> | True | False | None | '(' <expr> ')'",
      "<args> → <expr> <arg_rest> | ε",
      "<arg_rest> → ',' <expr> <arg_rest> | ε"
    ]
  }
}
